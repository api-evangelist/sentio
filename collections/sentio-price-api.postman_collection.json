        {
          "id": "10278546-c7d8-4d82-aae0-2e1a2b56152a",
          "name": "Get price",
          "request": {
            "name": "Get price",
            "description": {
              "content": "GetPrice returns the price of a given coin identifier, in a best effort way.\nIf we do not have any price data for the given coin, we will return NOT_FOUND error.\nIf we have at least one price data for the given coin, we will return it with the actual timestamp.\nClient is responsible for checking the timestamp and decide whether to use the price or not.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "prices"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "timestamp",
                  "value": "<dateTime>",
                  "description": "The timestamp we request the price at. Note, the price service may not have\nthe price at the exact timestamp, in which case it will return the price\nat the closest timestamp."
                },
                {
                  "disabled": false,
                  "key": "coinId.symbol",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "coinId.address.address",
