      "items": [
        {
          "info": {
            "name": "Get trace by bundle simulation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sentio.xyz/v1/solidity/:owner/:slug/:chainId/bundle/:bundleId/call_trace",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "slug",
                "value": "",
                "type": "path"
              },
              {
                "name": "chainId",
                "value": "",
                "type": "path"
              },
              {
                "name": "bundleId",
                "value": "",
                "type": "path"
              },
              {
                "name": "withInternalCalls",
                "value": "",
                "type": "query",
                "description": "Fetch the decoded trace, which will give you the function info, decoded parameters of both external and internal call trace."
              },
              {
                "name": "disableOptimizer",
                "value": "",
                "type": "query",
                "description": "Disable optimizations to make internal calls more accurate, but gas costs will differ from the actual execution."
              },
              {
                "name": "ignoreGasCost",
                "value": "",
                "type": "query",
                "description": "Only effective when disableOptimizer=true."
              }
            ]
          },
          "docs": "Get trace by bundle simulation"
        },
